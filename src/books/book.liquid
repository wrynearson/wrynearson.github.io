---
pagination:
  data: books.books_all
  size: 1
  alias: book
permalink: 'books/{{ book.book_id }}/index.html'
layout: base
---

<h1>{{ book.title }}</h1>

{% if book.api_error %}
<div class="error-message" style="background: #fff3cd; padding: 10px; border-radius: 5px; margin: 20px 0;">
  <strong>Note:</strong> {{ book.api_error_message }}
</div>
{% endif %}

<table class="table overview">
  <tbody class="table-body">
    {% if book.cover_url %}
    <tr class="table-row">
      <th class="table-head labels">Cover</th>
      <td class="cell">
        <img src="{{ book.cover_url }}" alt="Cover of {{ book.title }}" style="max-width: 200px;">
      </td>
    </tr>
    {% endif %}
    {% if book.authors and book.authors.size > 0 %}
    <tr class="table-row">
      <th class="table-head labels">
        {% if book.authors.size > 1 %}Authors{% else %}Author{% endif %}
      </th>
      <td class="cell">{{ book.authors | join: ", " }}</td>
    </tr>
    {% endif %}

    <tr class="table-row">
      <th class="table-head labels">ISBN</th>
      <td class="cell">{{ book.isbn }}</td>
    </tr>

    {% if book.publication_year %}
    <tr class="table-row">
      <th class="table-head labels">Publication Date</th>
      <td class="cell">{{ book.publication_year }}</td>
    </tr>
    {% endif %}

    {% if book.publisher %}
    <tr class="table-row">
      <th class="table-head labels">Publisher</th>
      <td class="cell">{{ book.publisher }}</td>
    </tr>
    {% endif %}

    {% if book.pages %}
    <tr class="table-row">
      <th class="table-head labels">Pages</th>
      <td class="cell">{{ book.pages }}</td>
    </tr>
    {% endif %}

    {% if book.genres and book.genres.size > 0 %}
    <tr class="table-row">
      <th class="table-head labels">Genres</th>
      <td class="cell">
        {% assign limited_genres = book.genres | slice: 0, 5 %}
        {{ limited_genres | join: ", " }}
      </td>
    </tr>
    {% endif %}

    <tr class="table-row">
      <th class="table-head labels">Status</th>
      <td class="cell">
        {% if book.status == "reading" %}
          Currently Reading
        {% else %}
          Read
        {% endif %}
      </td>
    </tr>

    {% if book.date %}
    <tr class="table-row">
      <th class="table-head labels">Started</th>
      <td class="cell">{{ book.date | dateFormat }}</td>
    </tr>
    {% endif %}

    {% if book.status != "reading" %}
    <tr class="table-row">
      <th class="table-head labels">Finished</th>
      <td class="cell">
        {% if book.end_date %}
          {{ book.end_date | dateFormat }}
        {% else %}
          —
        {% endif %}
      </td>
    </tr>
    {% endif %}

    {% if book.rating %}
    <tr class="table-row">
      <th class="table-head labels">Rating</th>
      <td class="cell">
        {% assign stars_out_of_5 = book.rating | times: 0.5 %}
        {% assign full_stars = stars_out_of_5 | floor %}
        {% assign has_half_star = stars_out_of_5 | minus: full_stars | at_least: 0.25 %}
        {% for i in (1..full_stars) %}★{% endfor %}{% if has_half_star >= 0.25 %}½{% endif %}{% assign empty_stars = 5 | minus: full_stars %}{% if has_half_star >= 0.25 %}{% assign empty_stars = empty_stars | minus: 1 %}{% endif %}{% for i in (1..empty_stars) %}☆{% endfor %}
      </td>
    </tr>
    {% endif %}
  </tbody>
</table>

{% if book.description %}
<details>
  <summary>Description</summary>
  <div>{{ book.description }}</div>
</details>
{% endif %}

{% if book.notes and book.notes != "" %}
<div class="book-notes" style="margin: 30px 0;">
  <h2>My Notes</h2>
  <div style="white-space: pre-wrap;">{{ book.notes }}</div>
</div>
{% endif %}

<br>

<footer class="footer">
    <div class="name_link">
        —
        <a href="{{ '/' | url }}">
            Will
        </a>
    </div>
    <div class="stats">
        <div class="words">
            {% fortawesomeRegular 'edit' %}
            <a href="{{ '/words' | url }}">
                <p title="I've written {{words.words}} words worth of notes in {{words.year}}, as of {{words.calculated}}">
                    {{ words.words }} words
                </p>
            </a>
        </div>
        <div class="coffee">
            <a href="{{ '/coffee'}}">☕️ {{ coffee.brews_combined.length }}</a>
        </div>
    </div>
</footer>
