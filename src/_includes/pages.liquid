---
layout: base.liquid
---

<div class="page_title">
  {% if url %}
    <a href={{ url }} target="_blank">
      {{ title }}
    </a>
  {% else %}
    {{ title }}
  {% endif %}
</div>

<div class="page_metadata">
  <time>
    {{ date | date: "%Y" }} –
    {% if end-date %}
      {{ end-date | date: "%Y" }}
    {% else %}
    {% endif %}
  </time>
  <span class="repo">
    {% if repo %}
      GitHub
    {% else %}
    {% endif %}
  </span>
  <span class="project_type">
    {% if type %}
      {{ type }}
    {% else %}
    {% endif %}
  </span>
</div>


<div class="description">
  {{ description }}
</div>

<div class="overview-box">
  <div class="overview-section">
    <h2 class="overview-title">Problem</h2>
    <p class="overview-text">{{ problem }}</p>
  </div>
  <div class="overview-section">
    <h2 class="overview-title">Outcome</h2>
    <p class="overview-text">
      {{ outcome }}
    </p>
  </div>
</div>
<hr class="page-separator" />
<div class="content">
  {{ content }}
</div>

<footer class="footer">
  <div class="name_link">
    —
    <a href="{{ '/' | url }}">
      Will
    </a>
  </div>
  <div class="stats">
    <div class="words">
      {% fortawesomeRegular 'edit' %}
      <a href="{{ '/words' | url }}">
        <p title="I've written {{words.words}} words worth of notes in {{words.year}}, as of {{words.calculated}}">
          {{ words.words }} words
        </p>
      </a>
    </div>
    <div class="coffee">
      <a href="{{ '/coffee'}}">☕️ {{ coffee.brews_combined.length }}</a>
    </div>
  </div>
</footer>