---
layout: base.liquid
---

<div class="page_title">
  {{ title }}
</div>

<time>{{ date | date: "%Y" }} – {{ end-date | date: "%Y" }}</time>

<div class="description">
  {{ description }}
</div>

<pre>      {{ coffee.beans | jsonify }}</pre>

<div class="overview-box">
  <div class="overview-section">
    <h2 class="overview-title">Problem</h2>
    <p class="overview-text">{{ problem }}</p>
  </div>
  <div class="overview-section">
    <h2 class="overview-title">Outcome</h2>
    <p class="overview-text">
      {{ outcome }}
    </p>
  </div>
</div>
<hr class="page-separator" />
<div class="content">
  {{ content }}
</div>
<footer class="footer">
  <div class="name_link">
    —
    <a href="{{ '/' | url }}">
      Will
    </a>
  </div>
  <div class="stats">
    {% comment %} reference: https://www.npmjs.com/package/@vidhill/fortawesome-free-regular-11ty-shortcode {% endcomment %}
    <div class="words">
      {% fortawesomeRegular 'edit' %}
      <a href="{{ '/words' | url }}">
        <p title="I've written {{words.words}} words worth of notes in {{words.year}}, as of {{words.calculated}}">
          {{ words.words }} words
          </p>
          </a>
      </div>
    </div>
  </div>
</footer>