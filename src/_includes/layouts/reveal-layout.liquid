<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>{{ page.title }}</title>
    <link rel="stylesheet" href="/reveal.js/reveal.css">
    <link rel="stylesheet" href="/reveal.js/theme/black.css">
  <!-- Or your chosen theme -->
  <!-- Additional Reveal.js or custom stylesheets here -->
  </head>
  <body>
    <div class="reveal">
      <div class="slides">
        {{ content }}
      </div>
    </div>

    <script src="/reveal.js/reveal.js"></script>
    <script>
        Reveal.initialize({
            slideNumber: true,
            autoSlide: 15000,
            height: 900
        });
    </script>

    <script src="plugin/markdown/markdown.js"></script>
    <script>
      Reveal.initialize({
        plugins: [ RevealMarkdown ]
      });
    </script>

  </body>
</html>